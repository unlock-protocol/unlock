    .bento-ambient {
      opacity: 0.86;
    }

    .bento-ambient path,
    .bento-ambient circle,
    .bento-ambient line {
      vector-effect: non-scaling-stroke;
    }

    .bento-ambient-archive {
      animation: bento-ambient-drift-a 10s ease-in-out infinite;
      transform-origin: 60% 48%;
    }

    .bento-ambient-growth {
      animation: bento-ambient-drift-b 8.5s ease-in-out infinite;
      transform-origin: 50% 76%;
    }

    .bento-ambient-control-ring {
      animation: bento-ambient-pulse 6.8s ease-in-out infinite;
      transform-origin: center;
    }

    .bento-ambient-agent path {
      animation: bento-ambient-dash 11s linear infinite;
    }

    .bento-ambient-audience {
      animation: bento-ambient-drift-c 9.5s ease-in-out infinite;
      transform-origin: 62% 46%;
    }

    @keyframes bento-ambient-drift-a {
      0%, 100% {
        opacity: 0.58;
        transform: translate3d(-4px, 3px, 0) scale(1);
      }

      50% {
        opacity: 0.9;
        transform: translate3d(5px, -5px, 0) scale(1.02);
      }
    }

    @keyframes bento-ambient-drift-b {
      0%, 100% {
        opacity: 0.58;
        transform: translate3d(0, 4px, 0);
      }

      50% {
        opacity: 0.9;
        transform: translate3d(0, -5px, 0);
      }
    }

    @keyframes bento-ambient-drift-c {
      0%, 100% {
        opacity: 0.56;
        transform: translate3d(4px, 0, 0) scale(1);
      }

      50% {
        opacity: 0.86;
        transform: translate3d(-5px, -3px, 0) scale(1.012);
      }
    }

    @keyframes bento-ambient-pulse {
      0%, 100% {
        opacity: 0.5;
        transform: scale(0.985);
      }

      50% {
        opacity: 0.86;
        transform: scale(1.025);
      }
    }

    @keyframes bento-ambient-dash {
      to {
        stroke-dashoffset: -26;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .bento-ambient-archive,
      .bento-ambient-growth,
      .bento-ambient-control-ring,
      .bento-ambient-agent path,
      .bento-ambient-audience {
        animation: none;
      }
    }
