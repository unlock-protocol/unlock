Book a demo
</a> </div> <button type="button" data-founder-avatar aria-label="Message from Colin, founder of Paragraph" class="stagger-fade pointer-events-auto size-14 shrink-0 cursor-pointer overflow-hidden rounded-full bg-white shadow-[0_10px_30px_-10px_rgba(26,22,19,0.45)] ring-1 ring-black/[0.08] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0f1115]/40" style="--stagger-fade-delay: 900ms" data-astro-cid-g7w3dhvr> <img src="/assets/images/founder-colin.jpeg" alt="" width="112" height="112" loading="lazy" decoding="async" class="size-full object-cover" data-astro-cid-g7w3dhvr> </button> </div> <script data-astro-rerun>
  ;(() => {
    const root = document.querySelector("[data-founder-greeting]")
    if (!root) return

    const card = root.querySelector("[data-founder-card]")
    const avatar = root.querySelector("[data-founder-avatar]")
    const dismiss = root.querySelector("[data-founder-dismiss]")
    const controller = new AbortController()
    const { signal } = controller

    const cta = card?.querySelector("a")

    /**
     * Restart the entrance animation on an element.
     *
     * Clearing `animation` and reading a layout property forces the style to
     * flush, so re-applying it starts a fresh run — without the reflow the
     * browser coalesces both writes and nothing replays.
     */
    const replay = (el, delay) => {
      if (!el) return
      el.style.setProperty("--stagger-fade-delay", `${delay}ms`)
      el.style.animation = "none"
      void el.offsetWidth
      el.style.animation = ""
    }

    const setDismissed = (value) => {
      if (value) root.setAttribute("data-dismissed", "")
      else root.removeAttribute("data-dismissed")
      avatar?.setAttribute("aria-expanded", value ? "false" : "true")

      // Reopening replays the greeting rather than snapping it back, but on a
      // click the visitor is already waiting, so it runs on a short beat rather
      // than the first-load delay.
      if (!value) {
        replay(card, 0)
        replay(cta, 160)
      }
    }

    avatar?.setAttribute("aria-expanded", "true")

    dismiss?.addEventListener("click", () => setDismissed(true), { signal })

    avatar?.addEventListener(
      "click",
      () => setDismissed(!root.hasAttribute("data-dismissed")),
      { signal }
    )

    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key !== "Escape") return
        if (root.hasAttribute("data-dismissed")) return
        setDismissed(true)
      },
      { signal }
    )

    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    })
