--color-foreground)10%,transparent)]"><div class="grid grid-cols-[auto_1fr] items-center gap-2"><span class="text-muted-foreground block w-14">Search</span><span class="bg-border h-2 w-2/3 rounded-full"></span></div><div class="grid grid-cols-[auto_1fr] items-center gap-2"><span class="text-muted-foreground block w-14">Social</span><span class="bg-border h-2 w-1/2 rounded-full"></span></div><div class="grid grid-cols-[auto_1fr] items-center gap-2"><span class="text-muted-foreground block w-14">Email</span><span class="bg-border h-2 w-1/3 rounded-full"></span></div></div></div></div></div></div></div><div data-slot="card" class="ring-foreground/6.5 bg-accent-subtle text-card-foreground relative isolate min-w-0 ring-1 grid grid-rows-[auto_1fr] gap-6 overflow-hidden rounded-2xl p-8"><div class="relative z-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share2 lucide-share-2 text-muted-foreground size-4" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg><h3 class="text-foreground mb-2 mt-4 font-medium">Distribution to every channel</h3><p class="text-muted-foreground">One post becomes a blog article, an X thread, a LinkedIn post, and a newsletter, sent across your channels once you sign off.</p></div><div class="relative z-10 flex flex-col justify-end"><div aria-hidden="true"><div class="bg-illustration ring-border-illustration shadow-black/6.5 flex items-center gap-2 rounded-xl p-3 shadow-md ring-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check size-4