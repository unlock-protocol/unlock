<div class="relative ml-auto h-4 w-12 overflow-hidden"><span class="absolute left-0 top-0 flex w-full flex-col items-end text-[10px] font-medium" style="transform:none"><span class="h-4 leading-4 text-muted-foreground">Prepare</span><span class="flex h-4 items-center gap-0.5 leading-4 text-emerald-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg> Done</span></span></div></div></div></div></div><p class="mt-5 text-balance leading-6 text-zinc-500"><strong class="font-medium text-[#0f1115]">Let the agent carry the load<!-- -->.</strong> <!-- -->Paragraph proposes next steps, drafts the assets, and runs recurring workflows within the boundaries you set.</p></div><!--astro:end--></astro-island> </div><div class="w-[min(22rem,calc(100vw-4rem))] shrink-0"> <astro-island uid="Z2dOiU1" prefix="r21" component-url="/_astro/WorkflowCarouselCard.1EdJiG5b.js" component-export="default" renderer-url="/_astro/client.D9vuQxea.js" props="{&quot;title&quot;:[0,&quot;Approve what ships&quot;],&quot;description&quot;:[0,&quot;You stay in control of every page, send, campaign, and workflow.&quot;],&quot;illustration&quot;:[0,&quot;approve&quot;],&quot;readerAvatars&quot;:[0]}" ssr client="visible" opts="{&quot;name&quot;:&quot;WorkflowCarouselCard&quot;,&quot;value&quot;:true}" await-children><div data-workflow-card="approve" translate="no" class="flex w-full cursor-default flex-col"><div class="flex aspect-square items-center justify-center overflow-hidden rounded-2xl bg-accent-subtle p-8 ring-1 ring-black/[0.05] transition-colors"><div aria-hidden="true" class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-card p-4 shadow-sm ring-1 ring-black/[0.06] relative"><div class="flex items-center gap-2 text-[11px] font-medium uppercase tracking-wide text-muted-fo