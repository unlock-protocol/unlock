ded-xl"><div class="m-auto size-fit *:size-8"><img src="https://integrations.sh/logo/airtable.com" alt="" width="36" height="36" decoding="async" referrerPolicy="no-referrer" class="size-9 object-contain"/></div></div></div></div></div><div class="absolute inset-0 m-auto flex size-fit -translate-y-3.5 items-center justify-center gap-3"><div aria-hidden="true" class="z-20 flex relative size-24 rounded-2xl border border-white/15 bg-[#0f1115] shadow-xl shadow-black/20 ring-1 ring-black/20"><div class="m-auto size-fit *:size-8"><svg class="text-white drop-shadow-sm" viewBox="0 0 81 82" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 0V76.1345H81" stroke="currentColor" stroke-width="10.6585" stroke-miterlimit="10"></path><path d="M34.4067 5.30176L6 76.1337L76.0722 46.9673" stroke="currentColor" stroke-width="10.6585" stroke-linejoin="round"></path><path d="M6 76.129L59.0302 21.5845" stroke="currentColor" stroke-width="10.6585" stroke-miterlimit="10"></path></svg></div></div></div></div></div></div><!--astro:end--></astro-island> </div> </section> </div> </div>  <section class="bg-[#0f1115] py-32 text-center text-white lg:py-48" data-analytics-location="footer-cta"> <div class="l2-narrow-container"> <div class="mb-10 flex justify-center text-white lg:mb-12"> <span class="scroll-drawn-mark" data-scroll-drawn-mark style="--logo-progress: 0; opacity: 0;" data-astro-cid-odakgpuq> <svg class="pmark" viewBox="0 0 81 82" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Paragraph" data-astro-cid-odakgpuq> <path class="pmark-l" d="M6 0V76.13H81" pathLength="1" stroke="currentColor" stroke-width="10.6585" stroke-miterlimit="10" data-astro-cid-odakgpuq></path> <line class="pmark-ray pmark-ray-low" x1="6" y1="76.13" x2="6" y2="0" stroke="currentColor" stroke-width="10.6585" data-astro-cid-odakgpuq></line> <line class="pmark-ray pmark-ray-mid" x1="6" y1="76.13" x2="6" y2="0" stroke="currentColor" stroke-width="10.6585" data-astro-cid-odakgpuq></line> <line class="pmark-ray pmark-ray-high" x1="6" y1="76.13" x2="6" y2="0" stroke="currentColor" stroke-width="10.6585" data-astro-cid-odakgpuq></line> </svg> </span> <script data-astro-rerun>
  ;(() => {
    const marks = Array.from(
      document.querySelectorAll("[data-scroll-drawn-mark]")
    )

    if (!marks.length) return

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches

    if (prefersReducedMotion) {
      marks.forEach((mark) => {
        mark.style.setProperty("--logo-progress", "1")
        mark.style.opacity = "1"
      })
      return
    }

    const smooth = (value) => {
      const t = Math.max(0, Math.min(1, value))
      return t * t * (3 - 2 * t)
    }

    const controller = new AbortController()
    const { signal } = controller
    let ticking = false
    let frame = 0

    const update = () => {
      frame = 0
      const viewportHeight = window.innerHeight || 1

      marks.forEach((mark) => {
        const top = mark.getBoundingClientRect().top
        const progress = smooth(
          (0.72 * viewportHeight - top) / (0.34 * viewportHeight)
        )

        mark.style.setProperty("--logo-progress", String(progress))
        mark.style.opacity = String(progress)
      })

      ticking = false
    }

    const requestUpdate = () => {
      if (ticking) return
      ticking = true
      frame = requestAnimationFrame(update)
    }

    update()
    window.addEventListener("scroll", requestUpdate, { passive: true, signal })
    window.addEventListener("resize", requestUpdate, { signal })
    window.addEventListener("load", requestUpdate, { signal })
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort()
        if (frame) cancelAnimationFrame(frame)
      },
      { once: true }
    )
  })()
</script> </div> <h2 class="font-landing-sans text-balance text-5xl font-[350] leading-[1.02] tracking-[-0.8px] lg:text-7xl"> Build a media engine your team can trust </h2> <p class="mx-auto mt-5 max-w-xl text-balance text-lg leading-[1.55] text-zinc-300"> Start from your company context, approve what ships, and hand Paragraph more of the publishing work over time. </p> <div class="mt-10 flex flex-wrap items-center justify-center gap-3"> 
