ter sent<!-- --> <span class="text-foreground/50 pl-0.5 text-xs">3s ago</span></span></div></div><div class="relative pl-6"><div class="border-foreground/15 absolute bottom-1/2 left-0 top-0 w-6 rounded-bl-full border-b border-l border-dashed"></div><div class="bg-card ring-border-illustration flex items-center gap-2 rounded-xl p-3 shadow ring-1"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-foreground size-3.5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg><span class="text-muted-foreground text-xs font-medium">Post on X<!-- --> <span class="text-foreground/50 pl-0.5 text-xs">now</span></span></div></div></div></div></div></div></div></div><div data-slot="card" class="ring-foreground/6.5 bg-accent-subtle text-card-foreground relative isolate min-w-0 ring-1 grid grid-rows-[auto_1fr] gap-8 overflow-hidden rounded-2xl p-8"><div aria-hidden="true" class="bento-ambient pointer-events-none absolute inset-0 z-0 overflow-hidden text-[#bdb2a4]" style="border-radius:inherit"><svg class="bento-ambient-agent absolute -right-24 top-2 h-96 w-80" viewBox="0 0 190 240" fill="none"><g stroke="currentColor" stroke-linecap="round" stroke-width="0.85"><path d="M22 216C52 172 44 134 88 116c48-19 48-57 76-92" opacity="0.68" stroke-dasharray="3 5"></path><path d="M2 184c38-28 68-28 88-62 20-35 46-52 92-58" opacity="0.5" stroke-dasharray="2 6"></path><path d="M44 238c20-50 52-72 84-82 28-9 42-24 58-56" opacity="0.42" stroke-dasharray="4 7"></path></g><g fill="currentColor" opacity="0.48"><circle cx="88" cy="116" r="2.5"></circle><circle cx="164" cy="24" r="2"></circle><circle cx="128" cy="156" r="2"></circle></g></svg></div><div class="relative z-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" c