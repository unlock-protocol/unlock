  ;(() => {
    const root = document.querySelector("[data-mega-root]")
    const mobileMenu = root?.querySelector("details")
    const mobileSummary = mobileMenu?.querySelector("summary")
    const mobileSummaryLabel = mobileSummary?.querySelector(
      "[data-mobile-menu-label]",
    )

    if (!root) return

    const controller = new AbortController()
    const { signal } = controller
    let bodyOverflowBeforeMobileOpen = ""

    const setMobileMenuLabel = (isOpen) => {
      const label = isOpen ? "Close menu" : "Open menu"
      mobileSummary?.setAttribute("aria-label", label)
      if (mobileSummaryLabel) mobileSummaryLabel.textContent = label
    }

    mobileMenu?.setAttribute("data-js", "")

    mobileMenu?.addEventListener("toggle", () => {
      const isOpen = mobileMenu.open
      if (isOpen) {
        bodyOverflowBeforeMobileOpen = document.body.style.overflow
        document.body.style.overflow = "hidden"
      } else {
        document.body.style.overflow = bodyOverflowBeforeMobileOpen
      }
      setMobileMenuLabel(isOpen)
      mobileMenu.removeAttribute("data-animate")
      if (isOpen) {
        void mobileMenu.offsetWidth
        mobileMenu.setAttribute("data-animate", "")
      }
    })
    window
      .matchMedia("(max-width: 640px)")
      .addEventListener(
        "change",
        (e) => {
          if (!e.matches && mobileMenu?.open) {
            mobileMenu.removeAttribute("open")
          }
        },
        { signal }
      )
    for (const link of root.querySelectorAll("a")) {
      link.addEventListener("click", () => {
        mobileMenu?.removeAttribute("open")
      })
    }
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape") {
          mobileMenu?.removeAttribute("open")
        }
      },
      { signal }
    )
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort()
        if (mobileMenu?.open) {
          document.body.style.overflow = bodyOverflowBeforeMobileOpen
        }
      },
      { once: true }
    )
  })()
</script> <script data-astro-rerun>
  ;(() => {
    const root = document.querySelector("[data-mega-root]")
    if (!root) return

    const controller = new AbortController()
    const { signal } = controller

    // Fill the bar with white once the reader scrolls away from the very top,
    // and fade it back to transparent at the top. rAF-throttled + passive so
    // it never blocks scrolling.
    const THRESHOLD = 8
    let scrolled
    let ticking = false

    const apply = () => {
      ticking = false
      const next = window.scrollY > THRESHOLD
      if (next === scrolled) return
      scrolled = next
      if (next) root.setAttribute("data-scrolled", "true")
      else root.removeAttribute("data-scrolled")
    }

    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(apply)
    }

    apply()
    window.addEventListener("scroll", onScroll, { passive: true, signal })
    document.addEventListener(
      "astro:before-swap",
      () => controller.abort(),
      { once: true }
    )
  })()
</script> <script data-astro-rerun>
  ;(() => {
    const root = document.querySelector("[data-mega-root]")
    if (!root) return

    const menus = [...root.querySelectorAll("[data-nav-menu]")]
    if (menus.length === 0) return

    const controller = new AbortController()
    const { signal } = controller

    // Escape closes the panel and hands focus back to the trigger — which
    // lands as a focusin on the menu and would reopen what we just dismissed.
    // Hold the reopen off until that focus has settled.
    let suppressFocusOpen = false

    // Deliberately does NOT set data-mega-open on the root. That attribute
    // fills the whole bar white, which is wrong over a dark hero — the bar
    // should keep its variant and let the panel float beneath it.
    const setOpen = (menu, open) => {
      const trigger = menu.querySelector("[data-nav-menu-trigger]")
      if (open) menu.setAttribute("data-state", "open")
      else menu.removeAttribute("data-state")
      trigger?.setAttribute("aria-expanded", open ? "true" : "false")
    }

    const closeAll = () => {
      for (const menu of menus) setOpen(menu, false)
    }

    const CLOSE_DELAY_MS = 140
    let closeTimer = 0

    const cancelClose = () => {
      window.clearTimeout(closeTimer)
      closeTimer = 0
    }

    const scheduleClose = (menu) => {
      cancelClose()
      closeTimer = window.setTimeout(() => setOpen(menu, false), CLOSE_DELAY_MS)
    }

    for (const menu of menus) {
      const trigger = menu.querySelector("[data-nav-menu-trigger]")

      // Hover is a mouse affordance only; touch taps arrive as a click, and
      // small screens use the <details> disclosures in the mobile panel.
      menu.addEventListener(
        "pointerenter",
        (e) => {
          if (e.pointerType !== "mouse") return
          cancelClose()
          closeAll()
          setOpen(menu, true)
        },
        { signal }
      )
      // Closing on a delay covers the diagonal: sliding from the trigger to a
      // link on the far side of the panel can clip a corner for a frame or two.
      menu.addEventListener(
        "pointerleave",
        (e) => {
          if (e.pointerType !== "mouse") return
          scheduleClose(menu)
        },
        { signal }
      )

      trigger?.addEventListener(
        "click",
        () => {
          const isOpen = menu.getAttribute("data-state") === "open"
          cancelClose()
          closeAll()
          setOpen(menu, !isOpen)
        },
        { signal }
      )

      // Keyboard: opening on focus lets Tab walk straight into the panel, and
      // focusout closes once focus has actually left the whole menu.
      menu.addEventListener(
        "focusin",
        () => {
          if (suppressFocusOpen) return
          setOpen(menu, true)
        },
        { signal }
      )
      menu.addEventListener(
        "focusout",
        (e) => {
          if (menu.contains(e.relatedTarget)) return
          setOpen(menu, false)
        },
        { signal }
      )
    }

    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key !== "Escape") return
        const open = menus.find((m) => m.getAttribute("data-state") === "open")
        if (!open) return
        const trigger = open.querySelector("[data-nav-menu-trigger]")
        cancelClose()
        suppressFocusOpen = true
        setOpen(open, false)
        trigger?.focus()
        requestAnimationFrame(() => {
          suppressFocusOpen = false
        })
      },
      { signal }
    )

    document.addEventListener(
      "pointerdown",
      (e) => {
        if (menus.some((menu) => menu.contains(e.target))) return
        cancelClose()
        closeAll()
      },
      { signal }
    )

    // Following a link inside a panel leaves it open behind the new page.
    for (const link of root.querySelectorAll("[data-nav-menu-panel] a")) {
      link.addEventListener("click", closeAll, { signal })
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort()
        cancelClose()
        closeAll()
      },
      { once: true }
    )
  })()
</script> 
