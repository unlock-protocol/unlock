</p>  <div aria-hidden class="pointer-events-none absolute bottom-0 left-1/2 w-screen -translate-x-1/2 border-b border-black/[0.07]"></div> </section> <!--
  Full-bleed, horizontally-scrolling card carousel framed by the page's vertical
  borders: the heading sits in a bordered box, a hairline runs above/below the
  cards, the card row bleeds past the right edge with a fade, and a subtle
  breathing line-art accent drifts to the left of the cards. Pass the cards in
  the default slot and any extra header action (e.g. a "Read more" link) in the
  "action" slot.
--> <section data-scroll-carousel class="l2-frame-container l2-scroll-carousel relative z-30" data-astro-cid-enbfb7om> <div class="l2-frame-bleed-x l2-scroll-carousel-heading border-x border-black/[0.07]" data-astro-cid-enbfb7om> <div class="l2-container" data-astro-cid-enbfb7om> <header class="relative flex w-full flex-wrap items-end justify-between gap-x-8 gap-y-6"> <div class="max-w-xl text-left max-md:pr-16"> <div> <h2 class="text-balance text-[2rem]/9 font-semibold tracking-normal text-[#0f1115] lg:text-[2.5rem]/[2.75rem]"> <span class="tw" data-astro-cid-upt36lve> <span class="tw-line" data-astro-cid-upt36lve>Run your</span> <span class="tw-line tw-rotor" data-tw-rotor data-tw-words="[&quot;content marketing&quot;,&quot;launches&quot;,&quot;newsletter&quot;,&quot;website&quot;,&quot;social&quot;]" data-astro-cid-upt36lve> <span class="tw-word" data-tw-word data-astro-cid-upt36lve>content marketing</span><span class="tw-caret" aria-hidden="true" data-astro-cid-upt36lve></span> </span> <span class="tw-line" data-astro-cid-upt36lve>with agents</span> </span> <script data-astro-rerun>
  ;(() => {
    const root = document.querySelector("[data-tw-rotor]")
    const wordEl = root?.querySelector("[data-tw-word]")
    if (!root || !wordEl) return

    let words = []
    try {
      words = JSON.parse(root.dataset.twWords || "[]")
    } catch {}
    if (words.length < 2) return

    // Leave the server-rendered first word in place for reduced-motion users.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    const TYPE_MS = 60 // per character while typing
    const DELETE_MS = 32 // per character while deleting
    const HOLD_MS = 1600 // pause on a fully typed word
    const BETWEEN_MS = 320 // pause on the empty word before the next one

    let index = 0
    let count = words[0].length // first word starts fully typed
    let deleting = false
    let timeout = 0

    function schedule(delay) {
      timeout = window.setTimeout(loop, delay)
    }

    function loop() {
      const word = words[index]

      if (deleting) {
        root.classList.add("is-typing")
        count -= 1
        wordEl.textContent = word.slice(0, count)
        if (count <= 0) {
          deleting = false
          index = (index + 1) % words.length
          schedule(BETWEEN_MS)
        } else {
          schedule(DELETE_MS)
        }
        return
      }

      count += 1
      wordEl.textContent = word.slice(0, count)
      if (count >= word.length) {
        root.classList.remove("is-typing") // blink the caret while holding
        deleting = true
        schedule(HOLD_MS)
      } else {
        root.classList.add("is-typing")
        schedule(TYPE_MS)
      }
    }

    // Hold the server-rendered first word, then start deleting it.
    deleting = true
    schedule(HOLD_MS)
    document.addEventListener(
      "astro:before-swap",
      () => window.clearTimeout(timeout),
      { once: true }
    )
  })()
</script>  </h2> </div> <p class="mt-4 max-w-md text-base/6 text-zinc-500 lg:text-lg/7"> Paragraph brings your company context, owned channels, and agent into one place, so publishing keeps moving while your team keeps building. </p> </div> <div class="shrink-0"> <div class="flex items-center gap-2" data-astro-cid-enbfb7om>  <button type="button" class="inline-flex h-9 items-center justify-center gap-1.5 rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 disabled:pointer-events-none disabled:opacity-40 border border-zinc-200 bg-white text-[#0f1115] hover:bg-zinc-50 focus-visible:ring-[#0f1115]/20 size-9 shrink-0" data-carousel-prev="true" aria-label="Scroll to previous" data-astro-cid-enbfb7om="true"> 
