12 6"></path><path d="m5.1 8-2.9-.8"></path><path d="m6 12-1.9 2"></path><path d="M7.2 2.2 8 5.1"></path><path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"></path></svg></div></div></div></div><p class="mt-5 text-balance leading-6 text-zinc-500"><strong class="font-medium text-[#0f1115]">Approve what ships<!-- -->.</strong> <!-- -->You stay in control of every page, send, campaign, and workflow.</p></div><!--astro:end--></astro-island> </div> </div> </div> <div aria-hidden="true" class="l2-scroll-carousel-edge-fade pointer-events-none absolute inset-y-0 left-1/2 z-20 w-screen -translate-x-1/2" data-astro-cid-enbfb7om></div> <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-1/2 w-screen -translate-x-1/2 border-b border-black/[0.07]" data-astro-cid-enbfb7om></div> </div> </section> <script data-astro-rerun>
  // Generic + idempotent so it works for every carousel on the page. Each
  // instance renders this verbatim (is:inline, because bundled scripts don't
  // reliably attach here); the IIFE avoids global const collisions and the
  // data-carouselWired flag stops double-wiring. Native scrollBy({smooth})
  // no-ops on the masked, full-bleed row, so we animate scrollLeft by hand.
  ;(() => {
    const easeOutCubic = (t) => 1 - (1 - t) ** 3

    const wire = (root) => {
      if (root.dataset.carouselWired) return
      const scroller = root.querySelector("[data-carousel-scroll]")
      if (!scroller) return
      root.dataset.carouselWired = "1"

      const animateScrollBy = (delta) => {
        const start = scroller.scrollLeft
        const max = scroller.scrollWidth - scroller.clientWidth
        const target = Math.max(0, Math.min(max, start + delta))
        const duration = 400
        let startTime = null

        const tick = (now) => {
          startTime ??= now
          const progress = Math.min(1, (now - startTime) / duration)
          scroller.scrollLeft =
            start + (target - start) * easeOutCubic(progress)
          if (progress < 1) requestAnimationFrame(tick)
        }

        requestAnimationFrame(tick)
      }

      // Advance by whole cards: the most card "pitches" (card width + gap) that
      // fit the visible band (clientWidth is the full viewport, capped at the
      // ~72rem content band). This snaps each click to a card boundary — one
      // full card on mobile (a full "screen"), a few on desktop — instead of a
      // flat 80% that left a card half-scrolled and needed repeated clicks.
      const step = () => {
        const visible = Math.min(scroller.clientWidth, 1152)
        const track = scroller.firstElementChild
        const card = track?.firstElementChild
        if (!card) return Math.round(visible * 0.8)
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0
        const pitch = card.getBoundingClientRect().width + gap
        if (!pitch) return Math.round(visible * 0.8)
        const count = Math.max(1, Math.floor((visible + gap) / pitch))
        return Math.round(count * pitch)
      }

      root
        .querySelector("[data-carousel-prev]")
        ?.addEventListener("click", () => animateScrollBy(-step()))
      root
        .querySelector("[data-carousel-next]")
        ?.addEventListener("click", () => animateScrollBy(step()))

      // Mouse click-drag to scroll. Touch and trackpad already pan the native
      // overflow row; this adds grab-and-drag for a mouse pointer. A small move
      // threshold flips `dragged` so the click that ends a drag does not follow
      // a card's link.
      let dragging = false
      let dragged = false
      let capturedPointerId = null
      let startX = 0
      let startLeft = 0

      scroller.style.cursor = "grab"

      scroller.addEventListener("dragstart", (event) => {
        event.preventDefault()
      })

      scroller.addEventListener("pointerdown", (event) => {
        if (event.pointerType !== "mouse") return
        dragging = true
        dragged = false
        capturedPointerId = null
        startX = event.clientX
        startLeft = scroller.scrollLeft
      })

      scroller.addEventListener("pointermove", (event) => {
        if (!dragging) return
        const delta = event.clientX - startX
        if (Math.abs(delta) > 4) {
          dragged = true
          if (capturedPointerId === null) {
            // Capture only after a real drag begins. Capturing on pointerdown
            // retargets plain card clicks to the scroller before links can open.
            try {
              scroller.setPointerCapture(event.pointerId)
              capturedPointerId = event.pointerId
            } catch {}
            document.body.style.cursor = "grabbing"
            scroller.style.userSelect = "none"
          }
          event.preventDefault()
          scroller.scrollLeft = startLeft - delta
        }
      })

      const endDrag = () => {
        if (!dragging) return
        dragging = false
        capturedPointerId = null
        document.body.style.cursor = ""
        scroller.style.userSelect = ""
      }
      scroller.addEventListener("pointerup", endDrag)
      scroller.addEventListener("pointercancel", endDrag)

      // Capture phase: swallow the click that ends a drag so card links and
      // analytics handlers do not fire on release.
      scroller.addEventListener(
        "click",
        (event) => {
          if (!dragged) return
          dragged = false
          event.preventDefault()
          event.stopPropagation()
        },
        true
      )
    }

    document.querySelectorAll("[data-scroll-carousel]").forEach(wire)
  })()
</script> <div class="relative"> <div aria-hidden class="pointer-events-none absolute bottom-0 left-1/2 top-0 z-0 w-full max-w-6xl -translate-x-1/2 border-x border-black/[0.07]"></div> <div class="relative z-10"> <section class="bg-background @container l2-section relative"> <div aria-hidden class="pointer-events-none absolute inset-y-0 left-1/2 z-0 w-full max-w-6xl -translate-x-1/2 border-x border-black/[0.07]"></div> <div class="l2-container relative z-10"> <header class="relative flex w-full flex-wrap items-end justify-between gap-x-8 gap-y-6"> <div class="max-w-xl text-left max-md:pr-16"> <div> <h2 class="text-balance text-[2rem]/9 font-semibold tracking-normal text-[#0f1115] lg:text-[2.5rem]/[2.75rem]"> A publishing system for launches, updates, and founder thinking  </h2> </div> <p class="mt-4 max-w-md text-base/6 text-zinc-500 lg:text-lg/7"> Bring your blog, newsletter, social distribution, landing pages, and recurring workflows into one workspace. Then let the agent do the work while your team keeps control. </p> </div> <div class="shrink-0"> <div class="flex flex-wrap items-center gap-3 justify-start" data-analytics-location="bento"> 
