{
  "extends": [
    "config:recommended",
    ":prHourlyLimitNone",
    ":pinAllExceptPeerDependencies",
    ":doNotPinPackage(node)"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": ["on the first day of the month"],
  "packageRules": [
    {
      "description": "Group non-major updates that no workspace rule below claims",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "matchFileNames": ["packages/contracts/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/contracts"
    },
    {
      "matchFileNames": ["packages/eslint-config/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/eslint-config"
    },
    {
      "matchFileNames": ["packages/hardhat-plugin/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/hardhat-plugin"
    },
    {
      "matchFileNames": ["packages/networks/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/networks"
    },
    {
      "matchFileNames": ["packages/paywall/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/paywall"
    },
    {
      "matchFileNames": ["packages/tsconfig/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/tsconfig"
    },
    {
      "matchFileNames": ["packages/types/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/types"
    },
    {
      "matchFileNames": ["packages/ui/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/ui"
    },
    {
      "matchFileNames": ["packages/unlock-express/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/unlock-express"
    },
    {
      "matchFileNames": ["packages/unlock-js/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages/unlock-js"
    },
    {
      "matchFileNames": ["tests/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tests"
    },
    {
      "matchFileNames": ["locksmith/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "locksmith"
    },
    {
      "matchFileNames": ["paywall-app/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "paywall-app"
    },
    {
      "matchFileNames": ["smart-contracts/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "smart-contracts"
    },
    {
      "matchFileNames": ["unlock-app/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "unlock-app"
    },
    {
      "matchFileNames": ["unlock-protocol.com/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "unlock-protocol.com"
    },
    {
      "matchFileNames": ["wedlocks/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "wedlocks"
    },
    {
      "matchFileNames": ["subgraph/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "subgraph"
    },
    {
      "matchFileNames": ["docker/development/eth-node/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "eth-node"
    }
  ],
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true
  },
  "prConcurrentLimit": 10,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  }
}
